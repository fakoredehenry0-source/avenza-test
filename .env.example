# ---------------------------------------------------------------------------
# Avenza configuration. Copy to .env and edit.
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Database. SQLite works out of the box. For Postgres:
# DATABASE_URL=postgresql+psycopg://avenza:avenza@localhost:5432/avenza
DATABASE_URL=sqlite:///./avenza.db

# Bank. mock = local simulated bank (clearly labelled). sandbox = organisers' API.
BANK_MODE=mock

# Speech providers: mock | yarn | deepgram | sahara | ai
# "ai" uses the vendored avenza_ai provider registry (Deepgram / YarnGPT /
# Sahara streaming) and falls back to mock when credentials are missing.
STT_PROVIDER=mock
TTS_PROVIDER=mock

# The demo client can send browser speech-recognition text or typed text.
# Set to false when a real STT provider is configured.
ALLOW_TEXT_UTTERANCE=true

# YarnGPT (see vendor docs; endpoint formats marked CONFIRM in the adapter)
YARN_API_KEY=
YARN_ASR_URL=
YARN_TTS_URL=
YARN_TTS_VOICE=

# Deepgram (second STT provider)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Sahara v2.5 (organisers' sandbox; placeholders marked CONFIRM)
SAHARA_API_KEY=
SAHARA_ASR_URL=

# LLM: OpenAI-compatible chat endpoint. Used ONLY for intent classification.
# If disabled or unavailable, the deterministic keyword fallback is used.
LLM_ENABLED=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_S=1.5

# --- AI/ML layer (vendored avenza_ai package) -----------------------------
# The backend parser remains the only amount authority. The AI layer can
# classify intent, cross-check a number, render a read-back or transcribe audio;
# it can never approve a transfer.
AI_ENABLED=true
AI_INTENT_ENABLED=true
# Optional safety cross-check: if the AI parser disagrees with the backend
# parser, the customer is asked again. It can never replace the amount.
AI_AMOUNT_CROSSCHECK=false
# Opt-in AI read-back template (bank-verified name, digit spelling on 13/30 etc).
AI_READBACK=false
# Use the AI time-phrase parser for "in October", "this year", "5 days ago".
AI_HISTORY=true
# Languages whose number words / intent words are enabled. Only "en" is
# currently verified; add yo/ha/ig only after the language test passes.
AI_LANGUAGES=en
AI_DEFAULT_LANGUAGE=en
AI_PROVIDER_CHOICE=reports/provider_choice.json
AI_STT_TIMEOUT_S=30

# YarnGPT names used by the AI package (YARN_* above still works).
YARNGPT_API_KEY=
YARNGPT_ASR_WS_URL=
YARNGPT_TTS_URL=https://yarngpt.ai/api/v1/tts
YARNGPT_DEFAULT_VOICE=

# WebAuthn. RP ID must be the registrable domain (localhost for local dev).
# Origin must match exactly what the browser shows, including scheme and port.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Avenza
WEBAUTHN_ORIGIN=http://localhost:8000

# Transfer rules
MAX_AMOUNT_KOBO=100000000
LARGE_AMOUNT_THRESHOLD_KOBO=5000000
NEW_RECIPIENT_HOLD_S=10
DUPLICATE_WINDOW_HOURS=24
DRAFT_TTL_S=120
READBACK_TTL_S=90
APPROVAL_TTL_S=60
SESSION_TTL_S=1800

# Developer/demo switches. Never enable ALLOW_DEV_APPROVAL in production:
# it bypasses the fingerprint and exists only for automated tests.
DEV_TOOLS=true
ALLOW_DEV_APPROVAL=false

# Static PWA directory (relative to the project root)
WEB_DIR=web

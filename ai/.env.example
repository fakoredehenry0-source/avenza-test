# Copy to .env and fill in. Nothing here is committed with real values.

# --- STT / TTS providers (YarnGPT and Sahara values are CONFIRM items: see README) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

YARNGPT_API_KEY=
YARNGPT_TTS_URL=https://yarngpt.ai/api/v1/tts          # CONFIRM against YarnGPT docs
YARNGPT_ASR_WS_URL=                                    # CONFIRM: live ASR websocket URL
YARNGPT_DEFAULT_VOICE=                                 # CONFIRM: a voice id from their docs

SAHARA_API_KEY=
SAHARA_ASR_WS_URL=                                     # CONFIRM

# --- LLM for intent only (any OpenAI-compatible chat endpoint with a Llama 3 model) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Which languages passed the language test (written by avenza_ai.eval.lang_test) ---
AVENZA_PROVIDER_CHOICE=reports/provider_choice.json

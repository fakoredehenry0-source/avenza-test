# Copy to deploy/forge/.env.forge (gitignored) and fill in. deploy.sh turns
# these into the "avenza-secrets" Kubernetes secret. Never commit real values.
#
# GATEWAY_KEY is NOT here: the platform team already put it in your namespace
# as the huawei-gateway secret.

DEEPGRAM_API_KEY=
YARN_API_KEY=
YARN_TTS_URL=
YARN_ASR_URL=
# A long random string. Needed for /audit and /dev/bank/* on the cluster.
ADMIN_TOKEN=
# Printed once by scripts/register_webhook.py. Leave empty on the first deploy.
FORGE_WEBHOOK_SECRET=
